{
  "name": "drone-maps",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "World-wide drone flight simulator in the browser. Pure frontend, no API keys.",
  "scripts": {
    "predev": "node scripts/copy-cesium.mjs",
    "dev": "vite",
    "prebuild": "node scripts/copy-cesium.mjs",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "deploy": "npm run build && gh-pages -d dist"
  },
  "dependencies": {
    "cesium": "^1.147.0",
    "maplibre-gl": "^6.17.0"
  },
  "devDependencies": {
    "gh-pages": "^6.3.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.8"
  }
}
